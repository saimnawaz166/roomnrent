# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
# VITE_SUPABASE_ANON_KEY is the publishable/anon key — safe to expose in the
# browser. Never put the secret/service_role key in a VITE_ variable; it
# would be bundled into the client JS and visible to anyone.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
